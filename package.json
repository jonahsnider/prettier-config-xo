{
	"name": "prettier-config-xo",
	"version": "0.0.0-development",
	"keywords": [
		"xo",
		"prettier",
		"prettier-config",
		"xo-config"
	],
	"bugs": {
		"url": "https://github.com/jonahsnider/prettier-config-xo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/prettier-config-xo.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonah.pw",
		"url": "https://jonah.pw"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./space": {
			"types": "./dist/space.d.ts",
			"default": "./dist/space.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "zshy",
		"deploy": "semantic-release",
		"lint": "xo",
		"lint:fix": "xo --fix",
		"style": "prettier --check .",
		"test": "node --test --experimental-test-coverage src/**/*.test.ts"
	},
	"prettier": "@jonahsnider/prettier-config",
	"devDependencies": {
		"@jonahsnider/prettier-config": "1.1.2",
		"@semantic-release/exec": "7.1.0",
		"@types/node": "^25.9.0",
		"eslint-plugin-prettier": "5.5.6",
		"prettier": "3.9.6",
		"semantic-release": "25.0.9",
		"typescript": "6.0.3",
		"xo": "4.0.0",
		"zshy": "0.7.3"
	},
	"packageManager": "pnpm@12.0.0",
	"engines": {
		"node": ">=10.13.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	},
	"zshy": {
		"cjs": false,
		"exports": {
			".": "./src/index.ts",
			"./space": "./src/space.ts"
		}
	}
}
